<?xml version="1.0" encoding="UTF-8"?>
<!-- logback-classic is on the test class path for the TaskLogAppender tests, so the SDK's own
     logging routes through it here; keep it at the level the tests ran at before. -->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="console"/>
  </root>
</configuration>
