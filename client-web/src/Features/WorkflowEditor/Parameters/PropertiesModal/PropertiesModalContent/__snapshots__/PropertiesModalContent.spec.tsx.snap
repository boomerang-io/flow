// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Inputs --- Snapshot Test > Capturing Snapshot of Inputs 1`] = `
<body
  id="app"
>
  <div>
    <form
      class="cds--bmrg-modal-flow-form"
    >
      <div
        aria-label="inputs"
        class="cds--layer-two cds--modal-content _container_862e8c"
      >
        <div
          class="_fields_862e8c"
        >
          <div>
            <p
              class="cds--label"
            >
              Name
            </p>
            <p
              class="_name_862e8c"
            >
              tim-property
            </p>
            <p
              class="cds--form__helper-text"
            >
              Tasks read it as $(params.tim-property). The name can't change once created.
            </p>
          </div>
          <div
            class="_row_862e8c"
          >
            <div
              class="cds--bmrg-text-input"
            >
              <div
                class="cds--form-item cds--text-input-wrapper"
              >
                <div
                  class="cds--text-input__label-wrapper"
                >
                  <label
                    class="cds--label"
                    dir="auto"
                    for="label"
                  >
                    <div
                      class="cds--bmrg-text-input__label"
                    >
                      <div>
                        Label (optional)
                      </div>
                    </div>
                  </label>
                </div>
                <div
                  class="cds--text-input__field-outer-wrapper"
                >
                  <div
                    class="cds--text-input__field-wrapper"
                  >
                    <input
                      aria-describedby="label-helper-text"
                      class="cds--text-input"
                      id="label"
                      placeholder="e.g. Commit"
                      title="e.g. Commit"
                      type="text"
                      value="Tim Property"
                    />
                    <span
                      aria-atomic="true"
                      aria-live="assertive"
                      class="cds--text-input__counter-alert"
                      role="alert"
                    />
                  </div>
                  <div
                    class="cds--form__helper-text"
                    dir="auto"
                    id="label-helper-text"
                  >
                    Shown when a run starts. Empty shows the name.
                  </div>
                </div>
              </div>
            </div>
            <div
              class="cds--bmrg-text-input"
            >
              <div
                class="cds--form-item cds--text-input-wrapper"
              >
                <div
                  class="cds--text-input__label-wrapper"
                >
                  <label
                    class="cds--label"
                    dir="auto"
                    for="description"
                  >
                    <div
                      class="cds--bmrg-text-input__label"
                    >
                      <div>
                        Description (optional)
                      </div>
                    </div>
                  </label>
                </div>
                <div
                  class="cds--text-input__field-outer-wrapper"
                >
                  <div
                    class="cds--text-input__field-wrapper"
                  >
                    <input
                      class="cds--text-input"
                      id="description"
                      type="text"
                      value="Tim property"
                    />
                    <span
                      aria-atomic="true"
                      aria-live="assertive"
                      class="cds--text-input__counter-alert"
                      role="alert"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="cds--form-item"
          >
            <div
              class="cds--select"
            >
              <label
                class="cds--label"
                dir="auto"
                for="type"
              >
                Type
              </label>
              <div
                class="cds--select-input__wrapper"
              >
                <select
                  class="cds--select-input"
                  id="type"
                  title=""
                >
                  <option
                    class="cds--select-option"
                    value="boolean"
                  >
                    Boolean
                  </option>
                  <option
                    class="cds--select-option"
                    value="email"
                  >
                    Email
                  </option>
                  <option
                    class="cds--select-option"
                    value="number"
                  >
                    Number
                  </option>
                  <option
                    class="cds--select-option"
                    value="password"
                  >
                    Password
                  </option>
                  <option
                    class="cds--select-option"
                    value="select"
                  >
                    Select
                  </option>
                  <option
                    class="cds--select-option"
                    value="text"
                  >
                    Text
                  </option>
                  <option
                    class="cds--select-option"
                    value="textarea"
                  >
                    Text Area
                  </option>
                  <option
                    class="cds--select-option"
                    value="url"
                  >
                    URL
                  </option>
                </select>
                <svg
                  aria-hidden="true"
                  class="cds--select__arrow"
                  fill="currentColor"
                  focusable="false"
                  height="16"
                  preserveAspectRatio="xMidYMid meet"
                  viewBox="0 0 16 16"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M8 11 3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"
                  />
                </svg>
              </div>
            </div>
          </div>
          <div
            class="cds--bmrg-text-input"
          >
            <div
              class="cds--form-item cds--text-input-wrapper"
            >
              <div
                class="cds--text-input__label-wrapper"
              >
                <label
                  class="cds--label"
                  dir="auto"
                  for="default"
                >
                  <div
                    class="cds--bmrg-text-input__label"
                  >
                    <div>
                      Default value (optional)
                    </div>
                  </div>
                </label>
              </div>
              <div
                class="cds--text-input__field-outer-wrapper"
              >
                <div
                  class="cds--text-input__field-wrapper"
                >
                  <input
                    class="cds--text-input"
                    data-testid="text-input"
                    id="default"
                    placeholder="No default"
                    title="No default"
                    type="text"
                    value="dogs"
                  />
                  <span
                    aria-atomic="true"
                    aria-live="assertive"
                    class="cds--text-input__counter-alert"
                    role="alert"
                  />
                </div>
              </div>
            </div>
          </div>
          <div
            class="cds--bmrg-toggle__container"
          >
            <div
              class="cds--bmrg-toggle --vertical"
            >
              <div
                class="cds--bmrg-toggle__title"
              >
                <label
                  class="cds--label"
                  for="required"
                  id="required-label"
                  style="margin-bottom: 0px;"
                >
                  Required
                </label>
              </div>
              <div
                class="cds--toggle"
              >
                <button
                  aria-checked="false"
                  aria-labelledby="required-label"
                  class="cds--toggle__button"
                  data-testid="toggle-test-id"
                  id="required"
                  role="switch"
                  type="button"
                />
                <div
                  class="cds--toggle__label"
                  id="required_label"
                >
                  <div
                    class="cds--toggle__appearance"
                  >
                    <div
                      class="cds--toggle__switch"
                    />
                    <span
                      aria-hidden="true"
                      class="cds--toggle__text"
                      dir="auto"
                    >
                      Not required
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <aside
          aria-label="Preview"
          class="_preview_862e8c"
        >
          <p
            class="_previewTitle_862e8c"
          >
            When a run starts
          </p>
          <div
            class="_previewField_862e8c"
          >
            <div
              class="cds--form-item cds--text-input-wrapper"
            >
              <div
                class="cds--text-input__label-wrapper"
              >
                <label
                  class="cds--label cds--label--disabled"
                  dir="auto"
                  for="parameter-preview"
                >
                  Tim Property
                </label>
              </div>
              <div
                class="cds--text-input__field-outer-wrapper"
              >
                <div
                  class="cds--text-input__field-wrapper"
                >
                  <input
                    aria-describedby="parameter-preview-helper-text"
                    class="cds--text-input"
                    disabled=""
                    id="parameter-preview"
                    placeholder="dogs"
                    title="dogs"
                    type="text"
                  />
                  <span
                    aria-atomic="true"
                    aria-live="assertive"
                    class="cds--text-input__counter-alert"
                    role="alert"
                  />
                </div>
                <div
                  class="cds--form__helper-text cds--form__helper-text--disabled"
                  dir="auto"
                  id="parameter-preview-helper-text"
                >
                  Tim property
                </div>
              </div>
            </div>
          </div>
          <p
            class="_previewNote_862e8c"
          >
            The same field appears in Run workflow and in a schedule's parameters.
          </p>
        </aside>
      </div>
      <div
        aria-busy="false"
        class="cds--modal-footer cds--btn-set"
      >
        <button
          class="cds--btn cds--btn--secondary"
          type="button"
        >
          Cancel
        </button>
        <button
          class="cds--btn cds--btn--primary cds--btn--disabled"
          data-testid="parameter-modal-confirm-button"
          disabled=""
          type="submit"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</body>
`;
