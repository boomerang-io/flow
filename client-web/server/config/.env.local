# Local dev env for `pnpm run prod:server` (`cd server && pnpm dev`), loaded via Node's
# --env-file flag (see server/package.json's "dev" script). NOT used by the Docker image -
# real deployments set these as real environment variables (see docker-compose.yml).
#
# APP_ROOT/CORE_ENV_URL/CORE_SERVICE_ENV_URL/PRODUCT_SERVICE_ENV_URL feed window._SERVER_DATA
# for the browser (see server/index.js's SERVER_DATA_ENV_KEYS and Config/appConfig.ts /
# Config/servicesConfig.ts). CORE_SERVICE_INTERNAL_ORIGIN is the separate server-side address
# route loaders call directly via process.env (Config/serverFetch.ts) - unset here on purpose,
# same as everywhere else today (see CLAUDE.md's hazards list).
PORT=3000
APP_ROOT=
CORE_ENV_URL=
CORE_SERVICE_ENV_URL=http://localhost:8000/api
PRODUCT_SERVICE_ENV_URL=http://localhost:8000/api
CORE_SERVICE_INTERNAL_ORIGIN=

