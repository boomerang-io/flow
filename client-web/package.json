{
  "name": "boomerang.app.flow",
  "version": "5.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://useboomerang.io",
  "sideEffects": false,
  "scripts": {
    "analyze": "source-map-explorer build/client/assets/*.js",
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint -f json -o lint-report.json ./src",
    "lint:staged": "eslint ./src",
    "lint:style": "stylelint \"src/**/*.{scss,css}\"",
    "start": "react-router-serve ./build/server/index.js",
    "test": "cross-env TZ=UTC vitest",
    "typecheck": "tsc --noEmit",
    "test:ui": "cross-env TZ=UTC vitest --ui",
    "test:ci": "cross-env TZ=UTC vitest --coverage",
    "test:staged": "cross-env TZ=UTC CI=true vitest related --changed --passWithNoTests",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@react-router/serve": "7.18.2",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@boomerang-io/carbon-addons-boomerang-react": "4.9.0-beta.15",
    "@boomerang-io/styles": "1.1.0",
    "@boomerang-io/utils": "1.1.0",
    "@carbon/charts": "^1.13.6",
    "@carbon/charts-react": "^1.13.6",
    "@carbon/pictograms-react": "^11.50.0",
    "@carbon/react": "1.75.0",
