    "axios": "^1",
    "c8": "^8.0.1",
    "change-case": "^4.1.2",
    "classnames": "^2.3.2",
    "codemirror": "^5.58.2",
    "copy-to-clipboard": "^3.3.1",
    "cronstrue": "^2.21.0",
    "cross-env": "7.0.2",
    "cz-conventional-changelog": "3.3.0",
    "d3": "^7.4.4",
    "d3-cloud": "^1.2.9",
    "d3-sankey": "^0.12.3",
    "detect-browser": "^5.3.0",
    "eslint": "^8.52.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-testing-library": "5.0.1",
    "flagged": "^2.0.1",
    "formik": "^2.4.6",
    "husky": "^8.0.3",
    "immer": "^9.0.6",
    "isbot": "^5.2.1",
