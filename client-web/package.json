    "source-map-explorer": "^2.5.2",
    "stylelint": "17.16.0",
    "typescript": "^5.2.2",
    "typescript-plugin-css-modules": "^5.0.2",
    "use-immer": "^0.8.1",
    "uuid": "^8.3.2",
    "validator": "^13.7.0",
    "vite": "^6.4.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^1.6.1",
    "yaml": "^2.3.2",
    "yup": "^0.32.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,scss,css,md}": [
      "prettier --print-width 120 --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "pnpm lint:staged",
      "pnpm test:staged"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "react-virtualized@9.22.5": "patches/react-virtualized@9.22.5.patch",
      "@boomerang-io/carbon-addons-boomerang-react@4.9.0-beta.15": "patches/@boomerang-io__carbon-addons-boomerang-react@4.9.0-beta.15.patch",
      "@boomerang-io/utils@1.1.0": "patches/@boomerang-io__utils@1.1.0.patch"
    },
    "allowUnusedPatches": true,
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "@parcel/watcher"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
