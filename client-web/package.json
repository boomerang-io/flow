    "postcss-scss": "4.0.9",
    "prettier": "3.0.3",
    "prop-types": "15.8.1",
    "query-string": "^6.14.1",
    "react": "^18",
    "react-beautiful-dnd": "^13.1.0",
    "react-big-calendar": "^1.5.2",
    "react-codemirror2": "^7.2.1",
    "react-copy-to-clipboard": "^5.0.1",
    "react-dom": "^18",
    "react-error-boundary": "^3.1.4",
    "react-helmet": "^6.1.0",
    "react-joyride": "^2.5.5",
